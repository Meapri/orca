--- /dev/null
+++ b/src/browser/PixelScroll.ts
@@ -0,0 +1,117 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+// Orca: pixel-precise viewport scrolling. The buffer still scrolls by whole rows (ydisp); a
+// renderer that supports it draws the remaining sub-row distance as an offset. Import-free and
+// limited to erasable TypeScript so Orca can unit test it straight from the installed package.
+
+/** Quiet time after the last scroll event before settling; outlasts trackpad momentum gaps. */
+export const PIXEL_SCROLL_SETTLE_DELAY_MS = 120;
+/** Length of the glide onto a whole row. */
+export const PIXEL_SCROLL_SETTLE_DURATION_MS = 90;
+/** A settle keeps going in the direction of travel once this much of the next row is showing. */
+export const PIXEL_SCROLL_SETTLE_FORWARD_FRACTION = 0.25;
+/** Offsets this close to a row edge snap to it, absorbing the canvas height's rounding. */
+const SNAP_DEVICE_PIXELS = 1.5;
+
+export interface IPixelScrollGate {
+  /** The `pixelScroll` option. */
+  enabled: boolean;
+  /** The active renderer draws a sub-row offset; the DOM renderer does not. */
+  rendererDrawsOffset: boolean;
+  isNormalBuffer: boolean;
+  /** An app requesting mouse reports owns the wheel. */
+  areMouseEventsActive: boolean;
+  prefersReducedMotion: boolean;
+}
+
+/** Pixel scrolling covers only viewport scrolling of the normal buffer; the rest steps rows. */
+export function isPixelScrollActive(gate: IPixelScrollGate): boolean {
+  return gate.enabled && gate.rendererDrawsOffset && gate.isNormalBuffer && !gate.areMouseEventsActive && !gate.prefersReducedMotion;
+}
+
+export interface IPixelScrollPosition {
+  /** The top buffer row drawn, i.e. ydisp. */
+  row: number;
+  /** Whole device pixels the viewport sits below that row's top edge; 0 draws whole rows. */
+  offset: number;
+}
+
+/** Maps a pixel scroll position to the top row and the sub-row offset drawn below its top edge. */
+export function resolvePixelScrollPosition(scrollTop: number, cssCellHeight: number, deviceCellHeight: number, maxRow: number): IPixelScrollPosition {
+  if (!(cssCellHeight > 0) || !(deviceCellHeight > 0)) {
+    return { row: 0, offset: 0 };
+  }
+  const rows = Math.max(scrollTop, 0) / cssCellHeight;
+  const row = Math.floor(rows + SNAP_DEVICE_PIXELS / deviceCellHeight);
+  // The last page has no row below it to reveal.
+  if (row >= maxRow) {
+    return { row: Math.max(maxRow, 0), offset: 0 };
+  }
+  return { row, offset: Math.max(Math.round((rows - row) * deviceCellHeight), 0) };
+}
+
+/** The whole row a settle lands on: the nearest one, biased toward the direction of travel. */
+export function resolvePixelScrollSettleRow(scrollTop: number, cssCellHeight: number, direction: number, maxRow: number): number {
+  if (!(cssCellHeight > 0)) {
+    return 0;
+  }
+  const rows = Math.max(scrollTop, 0) / cssCellHeight;
+  const floor = Math.floor(rows);
+  const fraction = rows - floor;
+  let row = Math.round(rows);
+  if (direction > 0) {
+    row = fraction >= PIXEL_SCROLL_SETTLE_FORWARD_FRACTION ? floor + 1 : floor;
+  } else if (direction < 0) {
+    row = fraction <= 1 - PIXEL_SCROLL_SETTLE_FORWARD_FRACTION ? floor : floor + 1;
+  }
+  return Math.min(Math.max(row, 0), Math.max(maxRow, 0));
+}
+
+/** Calls `onSettle` once scroll events stop arriving, with the direction they were travelling. */
+export class PixelScrollSettler {
+  private _timer: ReturnType<typeof setTimeout> | undefined;
+  private _lastScrollTop: number | undefined;
+  private _direction = 0;
+  private readonly _onSettle: (direction: number) => void;
+
+  constructor(onSettle: (direction: number) => void) {
+    this._onSettle = onSettle;
+  }
+
+  public get isPending(): boolean {
+    return this._timer !== undefined;
+  }
+
+  public noteScroll(scrollTop: number): void {
+    if (this._lastScrollTop !== undefined && scrollTop !== this._lastScrollTop) {
+      this._direction = Math.sign(scrollTop - this._lastScrollTop);
+    }
+    this._lastScrollTop = scrollTop;
+    if (this._timer !== undefined) {
+      clearTimeout(this._timer);
+    }
+    this._timer = setTimeout(() => {
+      this._timer = undefined;
+      const direction = this._direction;
+      this._lastScrollTop = undefined;
+      this._direction = 0;
+      this._onSettle(direction);
+    }, PIXEL_SCROLL_SETTLE_DELAY_MS);
+  }
+
+  public cancel(): void {
+    if (this._timer !== undefined) {
+      clearTimeout(this._timer);
+      this._timer = undefined;
+    }
+    this._lastScrollTop = undefined;
+    this._direction = 0;
+  }
+
+  public dispose(): void {
+    this.cancel();
+  }
+}
