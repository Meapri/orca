new file mode 100644
index 0000000000000000000000000000000000000000..fbd9855c62cbfbdab1fa867269f2860d46c89fbd
--- /dev/null
+++ b/src/browser/renderer/shared/WideGlyphFit.ts
@@ -0,0 +1,131 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+// Orca: sizes and centers wide glyphs whose fallback face leaves them narrower than their cells.
+// The WebGL addon cannot import new core files, so it ships a byte-identical copy; keep this file
+// import-free and limited to erasable TypeScript so Orca can unit test both copies as installed.
+
+/** Scripts a terminal font stack draws from one fallback face, so one scale keeps a line even. */
+export type WideGlyphScript = 'hangul' | 'han' | 'kana';
+
+// The script's scale and baseline shift must fit every glyph of the face: sample its extremes.
+const SCRIPT_SAMPLES: Record<WideGlyphScript, string> = {
+  hangul: '가갈뷁힣ㅎ',
+  han: '中國鬱龍語',
+  kana: 'あガぽヅカ'
+};
+
+export function getWideGlyphScript(code: number): WideGlyphScript | undefined {
+  if ((code >= 0xAC00 && code <= 0xD7A3) || (code >= 0x1100 && code <= 0x115F) ||
+    (code >= 0x3130 && code <= 0x318F) || (code >= 0xA960 && code <= 0xA97F)) {
+    return 'hangul';
+  }
+  if ((code >= 0x3040 && code <= 0x30FF) || (code >= 0x31F0 && code <= 0x31FF)) {
+    return 'kana';
+  }
+  if ((code >= 0x3400 && code <= 0x4DBF) || (code >= 0x4E00 && code <= 0x9FFF) ||
+    (code >= 0xF900 && code <= 0xFAFF) || (code >= 0x20000 && code <= 0x3FFFF)) {
+    return 'han';
+  }
+  return undefined;
+}
+
+/** The space a wide glyph may fill, measured from the alphabetic baseline it is drawn on. */
+export interface IWideGlyphBox {
+  /** Width of the cells the glyph occupies. */
+  span: number;
+  /** Room above the baseline, up to the top of the primary font's line box. */
+  ascent: number;
+  /** Room below the baseline, down to the bottom of the primary font's line box. */
+  descent: number;
+}
+
+export interface IWideGlyphFit {
+  /** Font size multiplier; 1 keeps the terminal font size. */
+  scale: number;
+  /** Space left of the scaled glyph that centers it in its span. */
+  offset: number;
+  /** How far to lower the baseline so the scaled ink stays inside the line box. */
+  shift: number;
+}
+
+/** The subset of TextMetrics the fit reads, measured at the alphabetic baseline. */
+export interface IWideGlyphMetrics {
+  width: number;
+  actualBoundingBoxAscent: number;
+  actualBoundingBoxDescent: number;
+}
+
+interface IInkExtent {
+  width: number;
+  ascent: number;
+  descent: number;
+}
+
+function inkExtent(metrics: IWideGlyphMetrics): IInkExtent {
+  return { width: metrics.width, ascent: metrics.actualBoundingBoxAscent, descent: metrics.actualBoundingBoxDescent };
+}
+
+/** Largest scale that keeps `ink` within the span and the line box's full height; below 1 when it cannot fit. */
+function maxScale(ink: IInkExtent, box: IWideGlyphBox): number {
+  const height = ink.ascent + ink.descent;
+  return Math.min(box.span / ink.width, height > 0 ? (box.ascent + box.descent) / height : Infinity);
+}
+
+/** The smallest baseline move that keeps `ink` at `scale` inside the line box. */
+function baselineShift(ink: IInkExtent, scale: number, box: IWideGlyphBox): number {
+  return Math.min(Math.max(0, ink.ascent * scale - box.ascent), box.descent - ink.descent * scale);
+}
+
+export class WideGlyphFitter {
+  private readonly _faces = new Map<string, { scale: number, ink: IInkExtent }>();
+
+  /**
+   * Fits a glyph that occupies exactly the cells of its first code point. `measure` reports the
+   * unscaled font; `fontKey` separates font variants. Undefined when the glyph already fills its
+   * span. Listed scripts grow as far as the span and line box allow, lowering the baseline only
+   * once the line box's ascent runs out; other glyphs only center.
+   */
+  public fit(chars: string, box: IWideGlyphBox, fontKey: string, measure: (text: string) => IWideGlyphMetrics): IWideGlyphFit | undefined {
+    const glyph = inkExtent(measure(chars));
+    if (!(glyph.width > 0) || glyph.width >= box.span) {
+      return undefined;
+    }
+    const script = getWideGlyphScript(chars.codePointAt(0) ?? 0);
+    const face = script && this._measureFace(script, box, fontKey, measure);
+    if (!face || face.scale <= 1) {
+      return { scale: 1, offset: (box.span - glyph.width) / 2, shift: 0 };
+    }
+    // Also bound by the glyph itself: a code point the samples miss may come from another face.
+    // Never shrinks: a glyph taller than the line box keeps its size and overflows it, as unfitted.
+    const scale = Math.max(1, Math.min(face.scale, maxScale(glyph, box)));
+    // The face's shift, not the glyph's, keeps every glyph of the face on one baseline; it only
+    // ever lowers, so an overflowing glyph never rises above where it draws unfitted.
+    const shift = Math.max(0, Math.min(
+      Math.max(baselineShift(face.ink, scale, box), glyph.ascent * scale - box.ascent),
+      box.descent - glyph.descent * scale
+    ));
+    return { scale, offset: (box.span - glyph.width * scale) / 2, shift };
+  }
+
+  private _measureFace(script: WideGlyphScript, box: IWideGlyphBox, fontKey: string, measure: (text: string) => IWideGlyphMetrics): { scale: number, ink: IInkExtent } {
+    const key = `${fontKey}|${script}|${box.span}|${box.ascent}|${box.descent}`;
+    let face = this._faces.get(key);
+    if (!face) {
+      const ink: IInkExtent = { width: 0, ascent: -Infinity, descent: -Infinity };
+      for (const sample of SCRIPT_SAMPLES[script]) {
+        const metrics = measure(sample);
+        if (metrics.width > 0) {
+          ink.width = Math.max(ink.width, metrics.width);
+          ink.ascent = Math.max(ink.ascent, metrics.actualBoundingBoxAscent);
+          ink.descent = Math.max(ink.descent, metrics.actualBoundingBoxDescent);
+        }
+      }
+      face = { scale: ink.width > 0 ? maxScale(ink, box) : 1, ink };
+      this._faces.set(key, face);
+    }
+    return face;
+  }
+}
