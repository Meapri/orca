+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import { IAdoptedCaret } from './Types';
+import { IBufferLine } from '../common/buffer/Types';
+import { BufferLine } from '../common/buffer/BufferLine';
+import { CellData } from '../common/buffer/CellData';
+import { FgFlags } from '../common/buffer/Constants';
+import { IBufferService, ICoreService } from '../common/services/Services';
+
+/** Where the embedder found the app's caret, in viewport-independent screen coordinates. */
+export type AdoptedCaretSource = () => { x: number, y: number } | undefined;
+
+/**
+ * Orca: a caret an app draws itself (an inverse cell) while it hides the real cursor, adopted so
+ * the renderers draw the terminal cursor there instead. Only what is drawn changes.
+ */
+export class AdoptedCaret implements IAdoptedCaret {
+  public row = 0;
+  public x = 0;
+  private _source: AdoptedCaretSource | undefined;
+  private readonly _line = new BufferLine(0);
+  private readonly _work = new CellData();
+
+  constructor(
+    private readonly _bufferService: IBufferService,
+    private readonly _coreService: ICoreService
+  ) {}
+
+  public setSource(source: AdoptedCaretSource | undefined): void {
+    this._source = source;
+  }
+
+  /** The adopted caret, or `undefined` while the real cursor is shown or none is adopted. */
+  public resolve(): IAdoptedCaret | undefined {
+    // Asked first so the source sees every pass, including ones with the cursor shown.
+    const at = this._source?.();
+    if (!at || !this._coreService.isCursorHidden) {
+      return undefined;
+    }
+    if (at.x < 0 || at.x >= this._bufferService.cols || at.y < 0 || at.y >= this._bufferService.rows) {
+      return undefined;
+    }
+    this.x = at.x;
+    this.row = this._bufferService.buffer.ybase + at.y;
+    return this;
+  }
+
+  public composeLine(source: IBufferLine): IBufferLine {
+    if (!(source instanceof BufferLine) || this.x >= source.length) {
+      return source;
+    }
+    source.loadCell(this.x, this._work);
+    if (!this._work.isInverse()) {
+      return source;
+    }
+    const line = this._line;
+    line.copyFrom(source);
+    // A wide cell's trailing half carries the inverse too.
+    const end = Math.min(this.x + Math.max(this._work.getWidth(), 1), source.length);
+    for (let x = this.x; x < end; x++) {
+      line.loadCell(x, this._work);
+      this._work.fg &= ~FgFlags.INVERSE;
+      line.setCell(x, this._work);
+    }
+    return line;
+  }
+}
