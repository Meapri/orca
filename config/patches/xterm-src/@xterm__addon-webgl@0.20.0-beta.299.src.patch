@@ -0,0 +1,259 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+// Orca: GPU cursor glide and blink fade for the WebGL renderer. Import-free and limited to erasable
+// TypeScript so Orca can unit test it straight from the installed package.
+
+/** Glide length; short enough that typing never feels laggy. */
+export const CURSOR_MOTION_DURATION_MS = 100;
+/** Blink fade length; must stay well under the 600ms blink interval. */
+export const CURSOR_BLINK_FADE_DURATION_MS = 150;
+/** Only moves this soon after local input glide, so output-driven moves snap. Covers SSH echo. */
+export const CURSOR_MOTION_INPUT_WINDOW_MS = 500;
+/** Glides allowed per input; further moves inside the window are TUI redraw churn. */
+export const CURSOR_MOTION_MOVES_PER_INPUT = 2;
+/** Larger row jumps are redraws or output, never typing. */
+export const CURSOR_MOTION_MAX_ROW_DELTA = 1;
+
+export interface ICursorMotionLines {
+  get(index: number): object | undefined;
+}
+
+export interface ICursorMotionSample {
+  x: number;
+  /** Absolute buffer row, so a glide stays anchored to content while output scrolls it. */
+  row: number;
+  width: number;
+  /** Cursor style; only compared, a change always snaps. */
+  style: string;
+  /** The active buffer's lines; a different list is an alt-screen switch. */
+  lines: ICursorMotionLines;
+}
+
+export interface ICursorMotionFrame {
+  /** False means draw exactly as upstream: settled cell, in-model block inversion, hard blink. */
+  isAnimating: boolean;
+  x: number;
+  row: number;
+  width: number;
+  opacity: number;
+}
+
+export class CursorMotionAnimator {
+  private _enabled = false;
+  private _reducedMotion = false;
+  private _lastInputTime = Number.NEGATIVE_INFINITY;
+  private _movesSinceInput = 0;
+
+  private _hasTarget = false;
+  private _targetX = 0;
+  private _targetRow = 0;
+  private _targetWidth = 1;
+  private _targetStyle = '';
+  private _targetLines: ICursorMotionLines | undefined;
+  private _targetLine: object | undefined;
+
+  private _inMotion = false;
+  private _motionStart = 0;
+  private _fromX = 0;
+  private _fromRow = 0;
+  private _fromWidth = 1;
+
+  private _blinkOn = true;
+  private _fading = false;
+  private _fadeStart = 0;
+  private _fadeDuration = 0;
+  private _fadeFrom = 1;
+  private _fadeTo = 1;
+
+  private readonly _frame: ICursorMotionFrame = { isAnimating: false, x: 0, row: 0, width: 1, opacity: 1 };
+
+  private readonly _now: () => number;
+
+  constructor(now: () => number) {
+    this._now = now;
+  }
+
+  /** Whether the last update produced an in-between frame, i.e. another frame is needed. */
+  public get isAnimating(): boolean {
+    return this._frame.isAnimating;
+  }
+
+  public setEnabled(enabled: boolean): void {
+    if (this._enabled !== enabled) {
+      this._enabled = enabled;
+      this.reset();
+    }
+  }
+
+  public setReducedMotion(reduced: boolean): void {
+    if (this._reducedMotion !== reduced) {
+      this._reducedMotion = reduced;
+      this.reset();
+    }
+  }
+
+  public notifyUserInput(): void {
+    this._lastInputTime = this._now();
+    this._movesSinceInput = 0;
+  }
+
+  /** Forgets the drawn position so the next update snaps. */
+  public reset(): void {
+    this._hasTarget = false;
+    this._targetLines = undefined;
+    this._targetLine = undefined;
+    this._inMotion = false;
+    this._fading = false;
+    this._frame.isAnimating = false;
+  }
+
+  /**
+   * Advances the animation for one rendered frame. `sample` is undefined while the cursor is hidden
+   * or outside the viewport. The returned frame is reused across calls.
+   */
+  public update(sample: ICursorMotionSample | undefined, blinkOn: boolean, isFocused: boolean): ICursorMotionFrame {
+    const isActive = this._enabled && !this._reducedMotion && isFocused;
+    if (!isActive || !sample) {
+      if (isActive) {
+        // Keep the last visible position: TUIs hide the cursor while redrawing, then show it again.
+        this._inMotion = false;
+        this._fading = false;
+      } else {
+        this.reset();
+      }
+      this._blinkOn = blinkOn;
+      return this._writeSettledFrame(sample, blinkOn);
+    }
+    const now = this._now();
+    if (!this._hasTarget || this._isTargetChange(sample)) {
+      this._retarget(sample, now);
+    } else if (blinkOn !== this._blinkOn) {
+      this._startFade(blinkOn ? 1 : 0, now);
+    }
+    this._blinkOn = blinkOn;
+    return this._writeFrame(now, blinkOn);
+  }
+
+  private _isTargetChange(sample: ICursorMotionSample): boolean {
+    return sample.x !== this._targetX ||
+      sample.row !== this._targetRow ||
+      sample.width !== this._targetWidth ||
+      sample.style !== this._targetStyle ||
+      sample.lines !== this._targetLines;
+  }
+
+  private _retarget(sample: ICursorMotionSample, now: number): void {
+    if (this._hasTarget && this._qualifiesForGlide(sample, now)) {
+      // Glide on from wherever the cursor is drawn now so quick successive moves stay continuous.
+      this._writeMotionPosition(now);
+      this._fromX = this._frame.x;
+      this._fromRow = this._frame.row;
+      this._fromWidth = this._frame.width;
+      this._motionStart = now;
+      this._inMotion = true;
+    } else {
+      this._inMotion = false;
+    }
+    // Blink restarts visible on every move; fading in at a new position would read as lag.
+    this._fading = false;
+    this._hasTarget = true;
+    this._targetX = sample.x;
+    this._targetRow = sample.row;
+    this._targetWidth = sample.width;
+    this._targetStyle = sample.style;
+    this._targetLines = sample.lines;
+    this._targetLine = sample.lines.get(sample.row);
+  }
+
+  private _qualifiesForGlide(sample: ICursorMotionSample, now: number): boolean {
+    const moveIndex = ++this._movesSinceInput;
+    return sample.lines === this._targetLines &&
+      sample.style === this._targetStyle &&
+      // Another line object under the old row means content shifted (scrollback trim, reflow).
+      sample.lines.get(this._targetRow) === this._targetLine &&
+      Math.abs(sample.row - this._targetRow) <= CURSOR_MOTION_MAX_ROW_DELTA &&
+      now - this._lastInputTime <= CURSOR_MOTION_INPUT_WINDOW_MS &&
+      moveIndex <= CURSOR_MOTION_MOVES_PER_INPUT;
+  }
+
+  private _startFade(to: number, now: number): void {
+    const from = this._fading ? this._fadeOpacityAt(now) : (this._blinkOn ? 1 : 0);
+    this._fadeFrom = from;
+    this._fadeTo = to;
+    this._fadeStart = now;
+    this._fadeDuration = CURSOR_BLINK_FADE_DURATION_MS * Math.abs(to - from);
+    this._fading = this._fadeDuration > 0;
+  }
+
+  private _fadeOpacityAt(now: number): number {
+    const t = Math.min(Math.max((now - this._fadeStart) / this._fadeDuration, 0), 1);
+    return this._fadeFrom + (this._fadeTo - this._fadeFrom) * t * t * (3 - 2 * t);
+  }
+
+  /** Writes the drawn position into the frame; returns whether the glide is still in flight. */
+  private _writeMotionPosition(now: number): boolean {
+    const frame = this._frame;
+    frame.x = this._targetX;
+    frame.row = this._targetRow;
+    frame.width = this._targetWidth;
+    if (!this._inMotion) {
+      return false;
+    }
+    const t = (now - this._motionStart) / CURSOR_MOTION_DURATION_MS;
+    if (t >= 1) {
+      this._inMotion = false;
+      return false;
+    }
+    const remaining = 1 - Math.max(t, 0);
+    const eased = 1 - remaining * remaining * remaining;
+    frame.x = this._fromX + (this._targetX - this._fromX) * eased;
+    frame.row = this._fromRow + (this._targetRow - this._fromRow) * eased;
+    frame.width = this._fromWidth + (this._targetWidth - this._fromWidth) * eased;
+    return true;
+  }
+
+  private _writeFrame(now: number, blinkOn: boolean): ICursorMotionFrame {
+    const frame = this._frame;
+    let isAnimating = this._writeMotionPosition(now);
+    frame.opacity = blinkOn ? 1 : 0;
+    if (this._fading) {
+      if (now - this._fadeStart >= this._fadeDuration) {
+        this._fading = false;
+      } else {
+        frame.opacity = this._fadeOpacityAt(now);
+        isAnimating = true;
+      }
+    }
+    frame.isAnimating = isAnimating;
+    return frame;
+  }
+
+  private _writeSettledFrame(sample: ICursorMotionSample | undefined, blinkOn: boolean): ICursorMotionFrame {
+    const frame = this._frame;
+    frame.isAnimating = false;
+    frame.x = sample?.x ?? 0;
+    frame.row = sample?.row ?? 0;
+    frame.width = sample?.width ?? 1;
+    frame.opacity = blinkOn ? 1 : 0;
+    return frame;
+  }
+}
+
+/** Reports `prefers-reduced-motion` now and on every change. */
+export function watchPrefersReducedMotion(
+  win: { matchMedia?: (query: string) => MediaQueryList },
+  onChange: (reduced: boolean) => void
+): { dispose(): void } {
+  const query = typeof win.matchMedia === 'function' ? win.matchMedia('(prefers-reduced-motion: reduce)') : undefined;
+  if (!query) {
+    onChange(false);
+    return { dispose: () => {} };
+  }
+  const listener = (event: MediaQueryListEvent): void => onChange(event.matches);
+  onChange(query.matches);
+  query.addEventListener('change', listener);
+  return { dispose: () => query.removeEventListener('change', listener) };
+}
