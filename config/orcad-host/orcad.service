# Managed by orcad-install.sh (service-install renders @...@ placeholders); edit orcad.env instead.
#
# orcad as a systemd *user* service. The user manager must outlive SSH logins, and the
# terminal daemon's own orca-daemon-*.scope lives under it, so enable lingering once:
#   sudo loginctl enable-linger "$USER"
# Reference: docs/reference/headless-linux-server.md, docs/reference/orcad-operations.md
[Unit]
Description=Orca headless runtime (orcad)
Documentation=https://github.com/stablyai/orca/blob/main/docs/reference/headless-linux-server.md
After=network-online.target
Wants=network-online.target
# A permanent startup fault stops after 5 tries in 5 minutes instead of spinning.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Optional systemd readiness and watchdog. orcad sends READY=1 after its readiness line and
# WATCHDOG=1 while its self-watchdog reports the runtime live, through the systemd-notify binary
# from its own PID, hence NotifyAccess=all. If the unit never leaves `activating` (an older
# systemd-notify), keep Type=simple and probe http://<bind>:<port>/readyz instead.
#Type=notify
#NotifyAccess=all
#WatchdogSec=60
Environment=ORCAD_BASE=@ORCAD_BASE@
Environment=ORCA_USER_DATA=@ORCA_USER_DATA@
Environment=ORCAD_BIND=127.0.0.1
Environment=ORCAD_PORT=6768
Environment=ORCAD_READINESS_FILE=%t/orcad/readiness.json
# Resource governance (docs/reference/orcad-operations.md#resource-governance). Each knob is an
# environment variable here or in orcad.env, or the same setting as `--limit <key>=<value>` in
# ORCAD_EXTRA_ARGS. The cgroup limits bound all terminal and agent work together, in the
# daemon's orca-daemon-*.scope, and apply only where that scope exists:
#Environment=ORCA_TERMINAL_MEMORY_HIGH=3G
#Environment=ORCA_TERMINAL_MEMORY_MAX=4G
#Environment=ORCA_TERMINAL_TASKS_MAX=4096
#Environment=ORCA_TERMINAL_HISTORY_RETENTION_DAYS=7
#Environment=ORCA_BROWSER_MAX_TABS=4
# Run orcad niced while terminals run at 0: the daemon resets each new PTY to nice 0, which
# needs RLIMIT_NICE; without LimitNICE= the reset is refused and terminals stay niced.
#Nice=10
#LimitNICE=20
EnvironmentFile=-@ORCAD_ENV_FILE@
RuntimeDirectory=orcad
# The readiness file in it carries a pairing credential.
RuntimeDirectoryMode=0700
# `run` resolves orcad-current to its real versioned dir and execs its pinned Node runtime,
# so the unit's main PID is orcad itself and SIGTERM reaches it directly.
ExecStart=/bin/sh @ORCAD_BASE@/orcad-current/deploy/orcad-install.sh run
Restart=always
RestartSec=5
# 78 (EX_CONFIG): bind address, data root or instance lock fault. Restarting cannot fix it.
RestartPreventExitStatus=78
# The daemon launch retries on a cold host; readiness can take tens of seconds.
TimeoutStartSec=180
# orcad's own graceful stop gives up after 15s.
TimeoutStopSec=30
# SIGTERM only to orcad; its cgroup remainder is reaped after it exits. Live terminals are
# preserved by the daemon's separate orca-daemon-*.scope, not by any KillMode — an unscoped
# fallback daemon (cgroupUnit null) dies with this unit whatever this is set to.
KillMode=mixed
# No UMask=: the daemon and its PTYs inherit it; orcad makes its data root 0700 itself.

[Install]
WantedBy=default.target
